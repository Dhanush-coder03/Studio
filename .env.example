# Environment variables for Velu Photography Studio (Local & Vercel)

# MongoDB Connection String (Required for MongoDB connectivity)
# Replace <username>, <password>, and the cluster URL with your MongoDB Atlas details:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/velu_studio?retryWrites=true&w=majority

# Environment
NODE_ENV=production

# CORS Origin (Optional, defaults to * to allow frontend access)
CORS_ORIGIN=*
