# Server Port
PORT=5000

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/velu_studio?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/velu_studio
MONGODB_URI=mongodb://127.0.0.1:27017/velu_studio

# Node Environment
NODE_ENV=development

# Allowed CORS Origins (comma separated or * in dev)
CORS_ORIGIN=*
